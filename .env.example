# Provenalt — environment variable template.
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env` or real secrets.
# This file documents variable NAMES and shapes only — no real values here, ever.
# In production, set these in the Railway/Vercel dashboards (see infra/README.md).

# ─────────────────────────────────────────────────────────────────────────────
# Core (packages/shared settings loader — prefix PROVENALT_)
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | staging | production
PROVENALT_ENVIRONMENT=development

# Log verbosity: DEBUG | INFO | WARNING | ERROR
PROVENALT_LOG_LEVEL=INFO

# Log output format: json (production) | console (local dev)
PROVENALT_LOG_FORMAT=console

# ─────────────────────────────────────────────────────────────────────────────
# Chain / RPC (indexer + api)
# ─────────────────────────────────────────────────────────────────────────────

# Base mainnet RPC endpoints, comma-separated. Provide AT LEAST TWO for provider
# rotation/fallback. Do NOT embed API keys you consider secret in a committed file.
PROVENALT_RPC_URLS=https://mainnet.base.org,https://base.publicnode.com

# Reorg safety: only finalize rows deeper than this many blocks (proposal §4, start 64).
PROVENALT_FINALITY_DEPTH=64

# Adaptive eth_getLogs chunk sizing (blocks per request). The chain client shrinks the
# chunk on block-range-cap errors / HTTP 429 and grows it back toward the max on success.
# INITIAL is intentionally conservative (2,000): free-tier providers rate-limit large cold
# scans, and the sizer grows toward MAX on success anyway.
PROVENALT_GETLOGS_INITIAL_CHUNK=2000
PROVENALT_GETLOGS_MIN_CHUNK=100
PROVENALT_GETLOGS_MAX_CHUNK=50000

# RPC rate-limit (HTTP 429) backoff. When every provider has 429'd the same request, the
# client sleeps with exponential backoff (INITIAL seconds, doubling, capped at MAX, with
# jitter) and retries up to MAX_RETRIES times before finally raising — so transient rate
# limits back off instead of crashing the long-running indexer.
PROVENALT_RPC_BACKOFF_INITIAL_SECONDS=2
PROVENALT_RPC_BACKOFF_MAX_SECONDS=60
PROVENALT_RPC_MAX_RETRIES=8

# ─────────────────────────────────────────────────────────────────────────────
# Database (Postgres) — provided by Railway as DATABASE_URL in production
# ─────────────────────────────────────────────────────────────────────────────

# Full Postgres connection string. Railway injects DATABASE_URL automatically for
# services attached to the Postgres plugin; locally, point this at your dev database.
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provenalt

# ─────────────────────────────────────────────────────────────────────────────
# Public API (services/api) — free-tier per-IP rate limit; partner API keys bypass it
# ─────────────────────────────────────────────────────────────────────────────

# Max requests per window, per client IP, before returning HTTP 429.
PROVENALT_API_RATE_LIMIT_REQUESTS=60
PROVENALT_API_RATE_LIMIT_WINDOW_SECONDS=60

# Pagination defaults/caps for list endpoints.
PROVENALT_API_DEFAULT_PAGE_SIZE=50
PROVENALT_API_MAX_PAGE_SIZE=200

# ─────────────────────────────────────────────────────────────────────────────
# x402 payment gating (paid tier: score / provenalt / eligibility) — see docs/x402.md
# ─────────────────────────────────────────────────────────────────────────────

# Turn payment enforcement on. When false (default), gated endpoints are open (dev).
PROVENALT_X402_ENABLED=false
# Receiving wallet address for settled USDC (REQUIRED when enabled). NEVER commit a real one.
PROVENALT_X402_PAY_TO=
# CAIP-2 network: eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia.
PROVENALT_X402_NETWORK=eip155:8453
# Per-call price.
PROVENALT_X402_PRICE=$0.01
# Facilitator base URL. Base MAINNET requires the Coinbase CDP facilitator (credentials);
# https://x402.org/facilitator serves testnets.
PROVENALT_X402_FACILITATOR_URL=https://x402.org/facilitator

# ─────────────────────────────────────────────────────────────────────────────
# MCP server (services/mcp) — thin client of the API
# ─────────────────────────────────────────────────────────────────────────────

# Partner API key the MCP server sends (X-API-Key) to bypass x402 on gated endpoints.
PROVENALT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Web (Next.js explorer on Vercel) — NEXT_PUBLIC_* is exposed to the browser
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the public API the explorer reads from.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
